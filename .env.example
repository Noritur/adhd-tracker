# Supabase (Noritur's Project — dxbzqvwoxfyegddecdbd)
NEXT_PUBLIC_SUPABASE_URL=https://dxbzqvwoxfyegddecdbd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — server-only, never exposed to client. Used by cron
# routes (/api/block-tick, /api/morning-nudge, /api/review) to bypass
# RLS for fan-out queries across all profiles.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key — auto-detected by @ai-sdk/google. Used by every AI
# touchpoint (planner, reschedule, insights, review, retro-fill,
# coach-nudge) via the runWithFallback helper.
GOOGLE_GENERATIVE_AI_API_KEY=

# Cron auth — shared secret required as `Authorization: Bearer ${CRON_SECRET}`
# on /api/block-tick (cron-job.org), /api/morning-nudge (Vercel cron),
# /api/review (Vercel cron).
CRON_SECRET=

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
# Public key is exposed to the client because the SW needs it to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
